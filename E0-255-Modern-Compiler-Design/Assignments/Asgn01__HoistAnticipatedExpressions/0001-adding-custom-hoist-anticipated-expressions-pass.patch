--- /dev/null
+++ b/llvm/include/llvm/Transforms/Utils/HoistAnticipatedExpression.h
@@ -0,0 +1,72 @@
+#ifndef HOIST_ANTICIPATED_EXPRESSIONS_H
+#define HOIST_ANTICIPATED_EXPRESSIONS_H
+
+#include "llvm/ADT/DenseMap.h"
+#include "llvm/ADT/DenseMapInfo.h"
+#include "llvm/ADT/SmallVector.h"
+#include "llvm/IR/PassManager.h"
+#include "llvm/IR/Type.h"
+#include "llvm/IR/Value.h"
+
+namespace llvm {
+
+class Function;
+class Instruction;
+
+// Represents a mathematical or cast expression for our analysis
+struct Expression {
+  unsigned opcode;
+  SmallVector<Value *, 4> operands;
+  Type *destType;
+
+  Expression() : opcode(0), destType(nullptr) {}
+
+  Expression(unsigned op, SmallVector<Value *, 4> ops, Type *ty = nullptr)
+      : opcode(op), operands(ops), destType(ty) {}
+
+  bool operator==(const Expression &other) const {
+    if (opcode != other.opcode || destType != other.destType)
+      return false;
+    if (operands.size() != other.operands.size())
+      return false;
+
+    // Check if all operands match
+    for (size_t i = 0; i < operands.size(); i++) {
+      if (operands[i] != other.operands[i]) return false;
+    }
+    return true;
+  }
+};
+
+// Custom hash function so we can use Expression as a key in LLVM's DenseMap (google search and other resources)
+template <> struct DenseMapInfo<Expression> {
+  static inline Expression getEmptyKey() {
+    return Expression(~0U, SmallVector<Value *, 4>(), nullptr);
+  }
+
+  static inline Expression getTombstoneKey() {
+    return Expression(~1U, SmallVector<Value *, 4>(), nullptr);
+  }
+
+  static unsigned getHashValue(const Expression &expr) {
+    unsigned hash = expr.opcode;
+    hash ^= (uintptr_t)expr.destType + 0x9e3779b9 + (hash << 6) + (hash >> 2);
+    for (Value *v : expr.operands) {
+      hash ^= (uintptr_t)v + 0x9e3779b9 + (hash << 6) + (hash >> 2);
+    }
+    return hash;
+  }
+
+  static bool isEqual(const Expression &a, const Expression &b) {
+    return a == b;
+  }
+};
+
+// The actual LLVM pass class
+struct HoistAnticipatedExpressionsPass : public PassInfoMixin<HoistAnticipatedExpressionsPass> {
+  PreservedAnalyses run(Function &F, FunctionAnalysisManager &AM);
+};
+
+} // namespace llvm
+
+#endif
