diff --git a/llvm/lib/Transforms/Utils/HoistAnticipatedExpression.cpp b/llvm/lib/Transforms/Utils/HoistAnticipatedExpression.cpp
new file mode 100644
index 000000000000..38ed8cc1cdda
--- /dev/null
+++ b/llvm/lib/Transforms/Utils/HoistAnticipatedExpression.cpp
@@ -0,0 +1,302 @@
+#include "llvm/Transforms/Utils/HoistAnticipatedExpression.h"
+#include "llvm/ADT/BitVector.h"
+#include "llvm/ADT/DenseMap.h"
+#include "llvm/ADT/DenseSet.h"
+#include "llvm/ADT/PostOrderIterator.h"
+#include "llvm/ADT/SmallVector.h"
+#include "llvm/ADT/STLExtras.h"
+#include "llvm/IR/BasicBlock.h"
+#include "llvm/IR/CFG.h"
+#include "llvm/IR/Dominators.h"
+#include "llvm/IR/Function.h"
+#include "llvm/IR/Instruction.h"
+#include "llvm/IR/Instructions.h"
+#include "llvm/IR/PassManager.h"
+#include "llvm/Support/Debug.h"
+#include "llvm/Support/raw_ostream.h"
+
+#define DEBUG_TYPE "hoist-anticipated-expressions"
+
+using namespace llvm;
+
+// Check if an instruction is safe to move around
+static bool isSafeToHoist(const Instruction &inst) {
+  if (isa<BinaryOperator>(&inst)) {
+    return !inst.mayHaveSideEffects();
+  }
+  if (isa<CastInst>(&inst)) {
+    return true;
+  }
+  if (const auto *callInst = dyn_cast<CallInst>(&inst)) {
+    if (callInst->isInlineAsm()) return false;
+
+    // Check if the call itself is marked safe
+    if (!callInst->mayHaveSideEffects()) return true;
+
+    // Fallback Check the function declaration
+    if (const Function *func = callInst->getCalledFunction()) {
+      return func->doesNotAccessMemory() || func->onlyReadsMemory();
+    }
+  }
+  return false;
+}
+
+// Check if a value doesn't depend on local block definitions
+static bool isAvailableEverywhere(const Value *val) {
+  return isa<Constant>(val) || isa<Argument>(val) || isa<GlobalValue>(val);
+}
+
+// Convert an Instruction into our canonical Expression struct
+static Expression getCanonicalExpression(const Instruction &inst) {
+  SmallVector<Value *, 4> ops(inst.op_begin(), inst.op_end());
+  Type *destType = nullptr;
+
+  if (const auto *binOp = dyn_cast<BinaryOperator>(&inst)) {
+    // Sort operands for commutative operations (like a+b == b+a)
+    if (binOp->isCommutative() && ops.size() >= 2 && ops[0] > ops[1]) {
+      std::swap(ops[0], ops[1]);
+    }
+  } else if (const auto *castInst = dyn_cast<CastInst>(&inst)) {
+    destType = castInst->getDestTy();
+  }
+
+  return Expression(inst.getOpcode(), ops, destType);
+}
+
+// Main pass implementation
+PreservedAnalyses HoistAnticipatedExpressionsPass::run(Function &F, FunctionAnalysisManager &AM) {
+  if (F.isDeclaration()) return PreservedAnalyses::all();
+
+  auto &domTree = AM.getResult<DominatorTreeAnalysis>(F);
+
+  // Reverse Post Order for processing blocks top-down
+  std::vector<BasicBlock *> rpoBlocks;
+  for (BasicBlock *bb : ReversePostOrderTraversal<Function *>(&F)) {
+    rpoBlocks.push_back(bb);
+  }
+
+  // Post Order for backward dataflow
+  std::vector<BasicBlock *> poBlocks;
+  for (BasicBlock *bb : post_order(&F)) {
+    poBlocks.push_back(bb);
+  }
+
+  bool functionChange = false;
+  bool changes = true;
+
+  // Loop until the code stops changing
+  while (changes) {
+    changes = false;
+
+    // Find all unique expressions in the function
+    DenseMap<Expression, unsigned> expressionToIndex;
+    std::vector<Expression> indexToExpression;
+
+    for (BasicBlock &bb : F) {
+      for (Instruction &instruction : bb) {
+        if (!isSafeToHoist(instruction)) continue;
+
+        Expression expr = getCanonicalExpression(instruction);
+        if (expressionToIndex.find(expr) == expressionToIndex.end()) {
+          expressionToIndex[expr] = indexToExpression.size();
+          indexToExpression.push_back(expr);
+        }
+      }
+    }
+
+    unsigned numExprs = indexToExpression.size();
+    if (numExprs == 0) break;
+
+    // Computing USE and DEF sets for each block
+    DenseMap<BasicBlock *, BitVector> useSet, defSet;
+    for (BasicBlock &bb : F) {
+      BitVector use(numExprs, false), def(numExprs, false);
+      DenseSet<Value *> definedLocally;
+
+      // Find USE
+      for (Instruction &inst : bb) {
+        if (isSafeToHoist(inst)) {
+          unsigned idx = expressionToIndex[getCanonicalExpression(inst)];
+          bool isExposed = true;
+
+          for (Value *op : inst.operands()) {
+            if (!isAvailableEverywhere(op) && definedLocally.count(op)) {
+              isExposed = false;
+              break;
+            }
+          }
+          if (isExposed) use.set(idx);
+        }
+        definedLocally.insert(&inst);
+      }
+
+      // Find DEF
+      for (Instruction &localDef : bb) {
+        for (auto pair : expressionToIndex) {
+          Expression expr = pair.first;
+          unsigned idx = pair.second;
+
+          for (Value *op : expr.operands) {
+            if (!isAvailableEverywhere(op) && op == &localDef) {
+              def.set(idx);
+              break;
+            }
+          }
+        }
+      }
+      useSet[&bb] = use;
+      defSet[&bb] = def;
+    }
+
+    // Backward Dataflow Analysis (Anticipated Expressions)
+    DenseMap<BasicBlock *, BitVector> antExpIn, antExpOut;
+    for (BasicBlock &bb : F) {
+      antExpIn[&bb] = BitVector(numExprs, true);
+      antExpOut[&bb] = BitVector(numExprs, true);
+    }
+
+    // Exits have no anticipated out
+    for (BasicBlock &bb : F) {
+      if (succ_empty(&bb)) antExpOut[&bb] = BitVector(numExprs, false);
+    }
+
+    bool dataflowChanged = true;
+    while (dataflowChanged) {
+      dataflowChanged = false;
+      for (BasicBlock *bb : poBlocks) {
+        // antExpOut = Intersection of antExpIn of all successors
+        BitVector newOut(numExprs, true);
+        bool hasSuccessor = false;
+
+        for (BasicBlock *succ : successors(bb)) {
+          newOut &= antExpIn[succ];
+          hasSuccessor = true;
+        }
+        if (!hasSuccessor) newOut = BitVector(numExprs, false);
+
+        // antExpIn = use U (antExpOut - def)
+        BitVector newIn = newOut;
+        newIn.reset(defSet[bb]);
+        newIn |= useSet[bb];
+
+        if (newOut != antExpOut[bb] || newIn != antExpIn[bb]) {
+          antExpOut[bb] = newOut;
+          antExpIn[bb] = newIn;
+          dataflowChanged = true;
+        }
+      }
+    }
+
+    // Hoisting the expressions
+    for (BasicBlock *bb : rpoBlocks) {
+      // Find unique successors
+      std::vector<BasicBlock *> uniqueSuccs;
+      for (BasicBlock *succ : successors(bb)) {
+        if (!llvm::is_contained(uniqueSuccs, succ)) {
+          uniqueSuccs.push_back(succ);
+        }
+      }
+
+      if (uniqueSuccs.empty() || antExpOut[bb].none()) continue;
+
+      // Checking which expressions we can hoist
+      std::vector<unsigned> candidates;
+      for (int idx : antExpOut[bb].set_bits()) {
+        candidates.push_back(idx);
+      }
+
+      for (unsigned idx : candidates) {
+        Expression expr = indexToExpression[idx];
+        std::vector<Instruction *> succInsts;
+        bool presentInAll = true;
+
+        for (BasicBlock *succ : uniqueSuccs) {
+          if (!domTree.dominates(bb, succ)) {
+            presentInAll = false;
+            break;
+          }
+
+          Instruction *foundInst = nullptr;
+          for (Instruction &inst : *succ) {
+            if (isSafeToHoist(inst) && getCanonicalExpression(inst) == expr) {
+              foundInst = &inst;
+              break;
+            }
+          }
+
+          if (!foundInst) {
+            presentInAll = false;
+            break;
+          }
+          succInsts.push_back(foundInst);
+        }
+
+        if (!presentInAll) continue;
+
+        // Clone the instruction and put it before the block's terminator
+        Instruction *proto = succInsts[0];
+        Instruction *hoisted = proto->clone();
+        hoisted->setName(proto->getName());
+        hoisted->insertBefore(bb->getTerminator()->getIterator());
+
+        // Replace old instructions with the hoisted one
+        for (Instruction *oldInst : succInsts) {
+          oldInst->replaceAllUsesWith(hoisted);
+          oldInst->eraseFromParent();
+        }
+
+        changes = true;
+        functionChange = true;
+      }
+    }
+
+    // Common Subexpression Elimination
+    DenseMap<Expression, std::vector<Instruction *>> exprMap;
+    for (BasicBlock *bb : rpoBlocks) {
+      for (Instruction &inst : *bb) {
+        if (isSafeToHoist(inst)) {
+          exprMap[getCanonicalExpression(inst)].push_back(&inst);
+        }
+      }
+    }
+
+    std::vector<Instruction *> instructionsToErase;
+    for (auto &pair : exprMap) {
+      auto &instList = pair.second;
+      if (instList.size() < 2) continue;
+
+      for (size_t i = 0; i < instList.size(); i++) {
+        if (!instList[i]) continue;
+
+        for (size_t j = i + 1; j < instList.size(); j++) {
+          if (!instList[j]) continue;
+
+          Instruction *instA = instList[i];
+          Instruction *instB = instList[j];
+
+          if (domTree.dominates(instA, instB)) {
+            instB->replaceAllUsesWith(instA);
+            instructionsToErase.push_back(instB);
+            instList[j] = nullptr;
+          } else if (domTree.dominates(instB, instA)) {
+            instA->replaceAllUsesWith(instB);
+            instructionsToErase.push_back(instA);
+            instList[i] = nullptr;
+            break;
+          }
+        }
+      }
+    }
+
+    for (Instruction *deadInst : instructionsToErase) {
+      deadInst->eraseFromParent();
+    }
+    if (!instructionsToErase.empty()) changes = true;
+  }
+
+  if (!functionChange) return PreservedAnalyses::all();
+
+  PreservedAnalyses PA;
+  PA.preserve<DominatorTreeAnalysis>();
+  return PA;
+}
\ No newline at end of file
diff --git a/llvm/test/Transforms/Util/hoist-anticipated-expressions.ll b/llvm/test/Transforms/Util/hoist-anticipated-expressions.ll
